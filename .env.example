# Example environment variables for ttmsabot-personalworkschedule
# Copy this file to `.env` (and/or `.env.local`) and fill in real values.
# IMPORTANT: Do NOT commit your real `.env` with secret keys to version control.
#
# In Vite, variables that should be accessible in client-side code must be prefixed with VITE_.
# Secrets that must remain server-only should NOT use the VITE_ prefix and must be kept out of client bundles.

# --------------------------------------------------------------------------
# Supabase (client-side) - safe to expose public anon key to browser
# Replace the placeholders with your actual Supabase project values.
# Example values below are fake and for illustration only.
# --------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key-placeholder-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------------------
# Supabase (server-side secret) - DO NOT expose this in client-side bundles.
# Keep this only in server-side env (e.g. backend, server endpoints) and never
# prefix with VITE_ if you don't want it exposed to the browser.
# --------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=service-role-secret-placeholder-xxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------------------
# Optional app-level settings (client-side)
# --------------------------------------------------------------------------
VITE_APP_TITLE="TTMSA Bot - Personal Work Schedule"
VITE_API_BASE=""    # If you have a backend proxy, set its base URL here

# --------------------------------------------------------------------------
# Environment & debug
# --------------------------------------------------------------------------
NODE_ENV=development
DEBUG=false

# Notes (EN / TH):
# - Copy this file to .env and fill in real values.
# - ใช้ไฟล์นี้เป็นตัวอย่าง เท่านั้น ให้คัดลอกเป็น `.env` แล้วใส่ค่าแท้จริง (อย่า commit ไฟล์ .env ที่มีคีย์ลับ)
# - If you use Vite + a plugin that reads `.env.meta`, create an `.env.meta` as needed to control metadata.
